# Apex Freight & Shipping Canada — local/dev environment variables.
# Copy to .env (same folder) and fill in your real values. Never commit .env.

# Port the backend listens on. Defaults to 5000 if unset.
PORT=5000

# Markup percentage applied to carrier buy rates when quoting shippers.
# Example: 15 means carrier cost x 1.15 = customer quote.
MARKUP_PERCENT=15

# EasyPost test (then production) API key. Get it from your EasyPost
# dashboard after creating an account: https://www.easypost.com
# (needed for live parcel/small-parcel carrier rates).
EASYPOST_API_KEY=

# Stripe secret key (starts sk_test_ / sk_live_). From the Stripe dashboard
# after creating a Stripe account: https://dashboard.stripe.com/apikeys
# (needed to accept customer payments).
STRIPE_SECRET_KEY=

# Stripe publishable key (starts pk_test_ / pk_live_). Same Stripe dashboard
# as above (needed by the frontend to tokenize payments securely).
STRIPE_PUBLISHABLE_KEY=

# Postgres connection string for the load-board / bidding persistence.
# Get one from Render (free) or Supabase: https://supabase.com
# Without this, the backend runs with an in-memory demo store instead.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The public URL of the frontend, used for Stripe redirect/callback URLs.
# Use http://localhost:5000 locally, or your custom domain in production
# (e.g. https://www.apexfreight.ca).
FRONTEND_ORIGIN=
